{
  "manifest_version": 3,
  "name": "Private Corrector",
  "version": "2.2.0",
  "description": "Select text and send it to claude.ai to correct it with minimal changes, reformulate it, make it academic, develop it, find research papers or ask anything.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "private-corrector@local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["menus", "activeTab", "scripting", "storage", "clipboardWrite", "notifications"],
  "host_permissions": ["https://claude.ai/*"],
  "background": {
    "scripts": ["common/actions.js", "background.js"]
  },
  "action": {
    "default_title": "Private Corrector",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "correct-selection": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Send the selected text to Claude for a minimal correction"
    },
    "ask-selection": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Ask Claude about the selected text"
    }
  }
}
