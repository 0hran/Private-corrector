{
  "manifest_version": 3,
  "name": "Private Corrector",
  "version": "5.0.0",
  "description": "Select text and send it to Claude, ChatGPT or Gemini to correct it with minimal changes, reformulate, shorten, make it academic, explain, find research papers or run your own saved prompts.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "private-corrector@local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "menus",
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite",
    "clipboardRead",
    "notifications"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*"
  ],
  "background": {
    "scripts": [
      "common/actions.js",
      "common/providers.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "Private Corrector",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "correct-selection": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Send the selected text for a minimal correction"
    },
    "ask-selection": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Ask a question about the selected text"
    }
  }
}
