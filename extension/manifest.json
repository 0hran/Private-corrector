{
  "manifest_version": 3,
  "name": "Private Corrector",
  "version": "7.2.0",
  "description": "Select text and send it to Gemini, Claude or ChatGPT to correct it with minimal changes, reformulate, shorten, make it academic, translate to French, explain, find research papers or run your own saved prompts.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "private-corrector@local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "menus",
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite",
    "clipboardRead",
    "notifications"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*"
  ],
  "background": {
    "scripts": [
      "common/compat.js",
      "common/actions.js",
      "common/providers.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "Private Corrector",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "correct-selection": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Send the selected text for a minimal correction"
    },
    "ask-selection": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Ask a question about the selected text"
    }
  }
}
